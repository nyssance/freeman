# A route as Python passes it: (method, path, handler_id, handler, dispatch, dispatch_sync).
type _RouteSpec = tuple[str, str, int, Any, Any, Any]
# A native route: (method, path, capsule).
type _NativeRouteSpec = tuple[str, str, Any]
# The route of a request that matches no route: (handler_id, handler, dispatch, dispatch_sync).
type _NoRouteSpec = tuple[int, Any, Any, Any]
# A WebSocket route: (path, handler_id, handler, injector).
type _WebSocketRouteSpec = tuple[str, int, Any, Any | None]

